<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="uMedia.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://uMedia/Styles/Widget.axaml" />
    </Application.Styles>

    <!-- Notification area icon: left click opens settings, right click gives the menu -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray.ico"
                      ToolTipText="uMedia"
                      Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Settings…" Click="OnTraySettingsClick" />
                        <NativeMenuItem Header="Show widget" Click="OnTrayShowClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Click="OnTrayQuitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
